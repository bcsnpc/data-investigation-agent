        "partitions": [
          {
            "name": "mart_encounter",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source=Sql.Database(ServerName,DatabaseName), Rows=Source{[Schema=\"dbo\",Item=\"mart_encounter\"]}[Data] in Rows"
            }
          }
        ],
        "measures": [
          {
            "name": "ALOS",
            "expression": "AVERAGEX(FILTER(mart_encounter,NOT ISBLANK(mart_encounter[admit_utc])&&NOT ISBLANK(mart_encounter[discharge_utc])),DIVIDE(DATEDIFF(mart_encounter[admit_utc],mart_encounter[discharge_utc],SECOND),86400))",
            "description": "Completed inpatient admission-to-discharge days, excludes active admissions.",
            "formatString": "#,0.00"
          },
          {
            "name": "30-day Readmission %",
            "expression": "DIVIDE(COUNTROWS(FILTER(mart_encounter,NOT ISBLANK(mart_encounter[readmission_of]))),COUNTROWS(FILTER(mart_encounter,NOT ISBLANK(mart_encounter[admit_utc]))))",
            "description": "Explicit same-person unplanned synthetic readmission links within30days; not risk adjusted.",
            "formatString": "0.00%"
          },
          {
            "name": "Visits",
            "expression": "COUNTROWS(mart_encounter)",
            "description": "Non-soft-deleted encounters of non-soft-deleted source patients; a transfer can contribute two visits.",
            "formatString": "#,0.00"
          },
          {
            "name": "Admissions",
            "expression": "COUNTROWS(FILTER(mart_encounter,NOT ISBLANK(mart_encounter[admit_utc])))",
            "description": "Retained encounters with an admission timestamp; includes active admissions.",
            "formatString": "#,0.00"
          },
          {
            "name": "Discharges",
            "expression": "COUNTROWS(FILTER(mart_encounter,NOT ISBLANK(mart_encounter[discharge_utc])))",
            "description": "Retained encounters with a discharge timestamp; excludes active encounters.",
            "formatString": "#,0.00"
          },
          {
            "name": "Unique Patients",
            "expression": "DISTINCTCOUNT(mart_encounter[mpi_patient_id])",
            "description": "Distinct MPI survivors among retained encounters, differs from distinct MRNs.",
            "formatString": "#,0.00"
          }
        ]
      },
