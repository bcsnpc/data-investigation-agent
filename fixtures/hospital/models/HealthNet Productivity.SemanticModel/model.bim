        "partitions": [
          {
            "name": "mart_order",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source=Sql.Database(ServerName,DatabaseName), Rows=Source{[Schema=\"dbo\",Item=\"mart_order\"]}[Data] in Rows"
            }
          }
        ],
        "measures": [
          {
            "name": "Order Turnaround (minutes)",
            "expression": "AVERAGEX(FILTER(mart_order,mart_order[status]=\"RESULTED\"&&NOT ISBLANK(mart_order[completed_utc])),DATEDIFF(mart_order[ordered_utc],mart_order[completed_utc],SECOND)/60)",
            "description": "Mean ordered-to-completed minutes for final resulted lines only; cancelled and voided lines excluded.",
            "formatString": "#,0.00"
          },
          {
            "name": "Order Count",
            "expression": "COUNTROWS(mart_order)",
            "description": "Retained order lines including cancelled and voided statuses; select status to narrow.",
            "formatString": "#,0.00"
          },
          {
            "name": "Completed Orders",
            "expression": "CALCULATE(COUNTROWS(mart_order),mart_order[status]=\"RESULTED\")",
            "description": "Final resulted status only; excludes withdrawn void/reentry predecessors.",
            "formatString": "#,0.00"
          }
        ]
      },
