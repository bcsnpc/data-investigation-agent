        "measures": [
          {
            "name": "RVU-style Workload per FTE",
            "expression": "DIVIDE(SUM(mart_provider_productivity_daily[workload_units]),SUMX(VALUES(core_provider[id]),CALCULATE(MAX(core_provider[fte]))))",
