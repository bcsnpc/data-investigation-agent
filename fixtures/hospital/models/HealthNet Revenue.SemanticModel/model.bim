        "partitions": [
          {
            "name": "mart_charge",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source=Sql.Database(ServerName,DatabaseName), Rows=Source{[Schema=\"dbo\",Item=\"mart_charge\"]}[Data] in Rows"
            }
          }
        ],
        "measures": [
          {
            "name": "Gross Charges",
            "expression": "SUM(mart_charge[amount_cents])/100",
            "description": "Signed gross charges by service date, including corrections; not collections.",
            "formatString": "#,0.00"
          },
          {
            "name": "Net Revenue",
            "expression": "[Gross Charges]+SUM(mart_adjustment[amount_cents])/100",
            "description": "Service-date gross charges plus signed adjustments in their adjustment-date window; not cash. Payer remapping uses each event date.",
            "formatString": "#,0.00"
          },
          {
            "name": "Gross Charges by Post Date",
            "expression": "CALCULATE([Gross Charges],USERELATIONSHIP(mart_charge[post_date],core_date[calendar_date]))",
            "description": "Same signed charges, grouped by post date rather than service date.",
            "formatString": "#,0.00"
          }
        ]
      },
