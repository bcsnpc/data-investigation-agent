            "name": "mart_remittance",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source=Sql.Database(ServerName,DatabaseName), Rows=Source{[Schema=\"dbo\",Item=\"mart_remittance\"]}[Data] in Rows"
            }
          }
        ],
        "measures": [
          {
            "name": "Denied Dollars",
            "expression": "CALCULATE(SUM(mart_remittance[denied_cents]),mart_remittance[is_original]=1)/100",
            "description": "Original adjudicated denied dollars by synthetic denial category.",
            "formatString": "#,0.00"
          },
          {
            "name": "Denial Rate ($)",
            "expression": "DIVIDE(CALCULATE(SUM(mart_remittance[denied_cents]),mart_remittance[is_original]=1),CALCULATE(SUMX(mart_remittance,mart_remittance[paid_cents]+mart_remittance[adjusted_cents]+mart_remittance[denied_cents]),mart_remittance[is_original]=1))",
            "description": "Denied dollars over original adjudicated remittance dollars; differs from count rate.",
            "formatString": "0.00%"
          }
        ]
      },
