        ],
        "partitions": [
          {
            "name": "mart_claim",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source=Sql.Database(ServerName,DatabaseName), Rows=Source{[Schema=\"dbo\",Item=\"mart_claim\"]}[Data] in Rows"
            }
          }
        ],
        "measures": [
          {
            "name": "Initial Denial Rate (count)",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(mart_claim),mart_claim[is_original]=1,mart_claim[status]=\"DENIED\"),CALCULATE(COUNTROWS(mart_claim),mart_claim[is_original]=1,mart_claim[status]<>\"SUBMITTED\"))",
            "description": "Original adjudicated claim count; pending claims excluded.",
            "formatString": "0.00%"
          },
          {
            "name": "Final Denial Rate",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(mart_claim),mart_claim[is_final]=1,mart_claim[status]=\"DENIED\"),CALCULATE(COUNTROWS(mart_claim),mart_claim[is_final]=1,mart_claim[status]<>\"SUBMITTED\"))",
            "description": "Latest version of each adjudicated claim group; differs from original claim rate.",
            "formatString": "0.00%"
          }
        ]
      },
