              "type": "m",
              "expression": "let Source=Sql.Database(ServerName,DatabaseName), Rows=Source{[Schema=\"dbo\",Item=\"mart_payment\"]}[Data] in Rows"
            }
          }
        ],
        "measures": [
          {
            "name": "Collections",
            "expression": "SUM(mart_payment[amount_cents])/100",
            "description": "Signed posted insurance and patient cash, including reversals, moves and refunds.",
