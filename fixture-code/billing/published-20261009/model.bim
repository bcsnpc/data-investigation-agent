            "dataType": "int64",
            "sourceColumn": "subscription_id",
            "summarizeBy": "none"
          },
          {
            "name": "account_id",
            "dataType": "int64",
            "sourceColumn": "account_id",
            "summarizeBy": "none"
          },
          {
            "name": "plan_id",
            "dataType": "int64",
            "sourceColumn": "plan_id",
            "summarizeBy": "none"
          },
          {
            "name": "status",
            "dataType": "string",
