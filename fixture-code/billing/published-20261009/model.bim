            }
          }
        ]
      },
      {
        "name": "Billing",
        "columns": [
          {
            "name": "invoice_id",
            "dataType": "int64",
            "sourceColumn": "invoice_id",
            "summarizeBy": "none"
          },
          {
            "name": "account_id",
            "dataType": "int64",
            "sourceColumn": "account_id",
            "summarizeBy": "none"
          },
          {
            "name": "plan_id",
            "dataType": "int64",
            "sourceColumn": "plan_id",
            "summarizeBy": "none"
          },
          {
            "name": "invoice_date",
            "dataType": "dateTime",
            "sourceColumn": "invoice_date",
            "summarizeBy": "none"
          },
          {
            "name": "amount",
            "dataType": "int64",
            "sourceColumn": "amount",
            "summarizeBy": "none"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Billing",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "gold",
              "entityName": "invoice_activity",
              "expressionSource": "BillingServingSource"
            }
          }
        ],
        "measures": [
          {
            "name": "Invoiced Amount",
            "expression": "SUM(Billing[amount])"
          },
          {
            "name": "MRR All Plans",
            "expression": "CALCULATE(SUMX(FILTER(Subscriptions, Subscriptions[status] = \"ACTIVE\"), RELATED(Plans[monthly_price])), REMOVEFILTERS(Plans))"
          },
          {
            "name": "Churned Accounts",
            "expression": "CALCULATE(DISTINCTCOUNT(Subscriptions[account_id]), Subscriptions[status] = \"CHURNED\")"
          },
          {
            "name": "Collected Amount",
            "expression": "SUM(Payments[amount])"
          },
          {
            "name": "Collected Fraction",
            "expression": "DIVIDE([Collected Amount], [Invoiced Amount])"
          },
          {
            "name": "Usage Overage",
            "expression": "SUMX(Usage, MAX(0, Usage[units] - RELATED(Plans[included_units])))"
          }
        ]
      },
      {
        "name": "Usage",
        "columns": [
          {
            "name": "event_id",
            "dataType": "int64",
            "sourceColumn": "event_id",
            "summarizeBy": "none"
          },
