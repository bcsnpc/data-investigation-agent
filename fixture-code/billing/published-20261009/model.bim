            "sourceColumn": "account_id",
            "summarizeBy": "none"
          },
          {
            "name": "event_date",
            "dataType": "dateTime",
            "sourceColumn": "event_date",
            "summarizeBy": "none"
          },
          {
            "name": "units",
            "dataType": "int64",
            "sourceColumn": "units",
            "summarizeBy": "none"
          },
          {
            "name": "plan_id",
            "dataType": "int64",
            "sourceColumn": "plan_id",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Usage",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "gold",
              "entityName": "usage_with_plan",
              "expressionSource": "BillingServingSource"
            }
          }
        ]
      },
