            {
              "type": "Query",
              "text": "CREATE TABLE [gold].[invoice_activity] (invoice_id int,account_id int,plan_id int,invoice_date date,amount int,status varchar(200));",
              "parameters": []
            },
            {
              "type": "Query",
              "text": "-- Fixture-authoring code only. Not executed or asserted to be deployed.\n-- Bronze tables are Dataflow Gen2 destinations; no literal-row staging here.\nCREATE PROCEDURE [silver].[build_invoices]\nAS\nBEGIN\n DELETE FROM [silver].[invoices];\n INSERT INTO [silver].[invoices] (invoice_id,account_id,invoice_date,amount,status)\n SELECT invoice_id,account_id,invoice_date,amount,status FROM [bronze].[invoices];\nEND;",
              "parameters": []
            },
            {
              "type": "Query",
              "text": "CREATE PROCEDURE [gold].[build_billing]\nAS\nBEGIN\n DELETE FROM [gold].[invoice_activity];\n INSERT INTO [gold].[invoice_activity] (invoice_id,account_id,plan_id,invoice_date,amount,status)\n SELECT i.invoice_id,i.account_id,h.plan_id,i.invoice_date,i.amount,i.status\n FROM [silver].[invoices] AS i\n LEFT JOIN [bronze].[account_plan_history] AS h ON i.account_id=h.account_id;\nEND;",
              "parameters": []
            },
            {
              "type": "Query",
              "text": "EXEC [silver].[build_invoices]; EXEC [gold].[build_billing];",
              "parameters": []
            },
            {
              "type": "Query",
              "text": "CREATE TABLE [gold].[usage_with_plan] AS SELECT u.event_id,u.account_id,u.event_date,u.units,s.plan_id FROM [bronze].[usage_events] u LEFT JOIN [bronze].[subscriptions] s ON u.account_id=s.account_id;",
              "parameters": []
            },
            {
              "type": "Query",
              "text": "CREATE TABLE [gold].[dates] AS SELECT DISTINCT invoice_date AS date FROM [bronze].[invoices] UNION SELECT DISTINCT payment_date FROM [bronze].[payments] UNION SELECT DISTINCT event_date FROM [bronze].[usage_events];",
              "parameters": []
            },
            {
              "type": "Query",
              "text": "SELECT COUNT_BIG(*) AS row_count,SUM(amount) AS amount FROM gold.invoice_activity; SELECT COUNT_BIG(*) AS row_count,SUM(amount) AS amount FROM silver.invoices;",
              "parameters": []
            }
