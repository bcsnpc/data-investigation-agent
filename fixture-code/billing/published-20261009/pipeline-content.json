        "typeProperties": {
          "database": "billing_ops",
          "scripts": [
            {
              "type": "NonQuery",
              "text": "DECLARE @r bigint=0,@w bigint=0;\nIF ISJSON(@copy_0)<>1 OR TRY_CONVERT(bigint,JSON_VALUE(@copy_0,'$.rowsRead')) IS NULL OR TRY_CONVERT(bigint,JSON_VALUE(@copy_0,'$.rowsCopied')) IS NULL THROW 51002,'Own copy accounting unavailable.',1;\nSET @r=@r+CONVERT(bigint,JSON_VALUE(@copy_0,'$.rowsRead')); SET @w=@w+CONVERT(bigint,JSON_VALUE(@copy_0,'$.rowsCopied'));\nIF ISJSON(@copy_1)<>1 OR TRY_CONVERT(bigint,JSON_VALUE(@copy_1,'$.rowsRead')) IS NULL OR TRY_CONVERT(bigint,JSON_VALUE(@copy_1,'$.rowsCopied')) IS NULL THROW 51002,'Own copy accounting unavailable.',1;\nSET @r=@r+CONVERT(bigint,JSON_VALUE(@copy_1,'$.rowsRead')); SET @w=@w+CONVERT(bigint,JSON_VALUE(@copy_1,'$.rowsCopied'));\nIF ISJSON(@copy_2)<>1 OR TRY_CONVERT(bigint,JSON_VALUE(@copy_2,'$.rowsRead')) IS NULL OR TRY_CONVERT(bigint,JSON_VALUE(@copy_2,'$.rowsCopied')) IS NULL THROW 51002,'Own copy accounting unavailable.',1;\nSET @r=@r+CONVERT(bigint,JSON_VALUE(@copy_2,'$.rowsRead')); SET @w=@w+CONVERT(bigint,JSON_VALUE(@copy_2,'$.rowsCopied'));\nIF ISJSON(@copy_3)<>1 OR TRY_CONVERT(bigint,JSON_VALUE(@copy_3,'$.rowsRead')) IS NULL OR TRY_CONVERT(bigint,JSON_VALUE(@copy_3,'$.rowsCopied')) IS NULL THROW 51002,'Own copy accounting unavailable.',1;\nSET @r=@r+CONVERT(bigint,JSON_VALUE(@copy_3,'$.rowsRead')); SET @w=@w+CONVERT(bigint,JSON_VALUE(@copy_3,'$.rowsCopied'));\nIF ISJSON(@copy_4)<>1 OR TRY_CONVERT(bigint,JSON_VALUE(@copy_4,'$.rowsRead')) IS NULL OR TRY_CONVERT(bigint,JSON_VALUE(@copy_4,'$.rowsCopied')) IS NULL THROW 51002,'Own copy accounting unavailable.',1;\nSET @r=@r+CONVERT(bigint,JSON_VALUE(@copy_4,'$.rowsRead')); SET @w=@w+CONVERT(bigint,JSON_VALUE(@copy_4,'$.rowsCopied'));\nIF ISJSON(@copy_5)<>1 OR TRY_CONVERT(bigint,JSON_VALUE(@copy_5,'$.rowsRead')) IS NULL OR TRY_CONVERT(bigint,JSON_VALUE(@copy_5,'$.rowsCopied')) IS NULL THROW 51002,'Own copy accounting unavailable.',1;\nSET @r=@r+CONVERT(bigint,JSON_VALUE(@copy_5,'$.rowsRead')); SET @w=@w+CONVERT(bigint,JSON_VALUE(@copy_5,'$.rowsCopied'));\nIF ISJSON(@copy_6)<>1 OR TRY_CONVERT(bigint,JSON_VALUE(@copy_6,'$.rowsRead')) IS NULL OR TRY_CONVERT(bigint,JSON_VALUE(@copy_6,'$.rowsCopied')) IS NULL THROW 51002,'Own copy accounting unavailable.',1;\nSET @r=@r+CONVERT(bigint,JSON_VALUE(@copy_6,'$.rowsRead')); SET @w=@w+CONVERT(bigint,JSON_VALUE(@copy_6,'$.rowsCopied'));\nIF EXISTS(SELECT 1 FROM dbo.load_run_audit WHERE run_id=@run_id) THROW 51003,'Run already recorded.',1;\nINSERT INTO dbo.load_run_audit (run_id,pipeline_name,status,rows_read,rows_written,accounting_state,start_time_utc,end_time_utc,high_watermark) VALUES (@run_id,@pipeline_name,'Succeeded',@r,@w,'OBSERVED_COPY_OUTPUT',@started,CONVERT(varchar(40),SYSUTCDATETIME(),127),NULL);",
              "parameters": [
