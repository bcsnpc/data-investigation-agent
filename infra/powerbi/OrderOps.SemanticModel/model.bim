        "description": "Gold order_line_summary; validated snapshot f4e5f3e9-455b-4f99-9a55-408268444b8c.",
        "partitions": [
          {
            "name": "FactOrderLine",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "schemaName": "dbo",
              "entityName": "order_line_summary",
              "expressionSource": "GoldSource"
            }
          }
        ],
        "measures": [
          {
            "name": "Gross Sales",
            "expression": "IF(HASONEVALUE(FactOrderLine[currency]), SUM(FactOrderLine[gross_sales_amount]))",
            "formatString": "#,##0.00",
            "description": "Gold gross_sales_amount, by original order-date cohort. Blank across multiple currencies. Paid cancellations preserve capture and refund history.",
            "displayFolder": "Financial",
            "lineageTag": "c83b586a-c4b3-54df-beec-c90cb6fdca17"
          },
          {
            "name": "Discount Amount",
            "expression": "IF(HASONEVALUE(FactOrderLine[currency]), SUM(FactOrderLine[discount_amount]))",
            "formatString": "#,##0.00",
            "description": "Gold discount_amount, by original order-date cohort. Blank across multiple currencies. Paid cancellations preserve capture and refund history.",
            "displayFolder": "Financial",
            "lineageTag": "48a76272-9db4-5a86-86e4-61c13438b4f4"
          },
          {
            "name": "Sales Amount",
            "expression": "IF(HASONEVALUE(FactOrderLine[currency]), SUM(FactOrderLine[sales_amount]))",
            "formatString": "#,##0.00",
            "description": "Gold sales_amount, by original order-date cohort. Blank across multiple currencies. Paid cancellations preserve capture and refund history.",
            "displayFolder": "Financial",
            "lineageTag": "3bad03a8-99fa-50ba-a90e-e25f9af61475"
          },
          {
            "name": "Tax Amount",
            "expression": "IF(HASONEVALUE(FactOrderLine[currency]), SUM(FactOrderLine[tax_amount]))",
            "formatString": "#,##0.00",
            "description": "Gold tax_amount, by original order-date cohort. Blank across multiple currencies. Paid cancellations preserve capture and refund history.",
            "displayFolder": "Financial",
            "lineageTag": "27f324d3-1c97-58c4-83dc-defebe0262b9"
          },
          {
            "name": "Captured Amount",
            "expression": "IF(HASONEVALUE(FactOrderLine[currency]), SUM(FactOrderLine[captured_amount]))",
            "formatString": "#,##0.00",
            "description": "Gold captured_amount, by original order-date cohort. Blank across multiple currencies. Paid cancellations preserve capture and refund history.",
            "displayFolder": "Financial",
            "lineageTag": "0c88edd2-d670-5006-a5c5-4aef4e4530e7"
          },
          {
            "name": "Refunded Sales",
            "expression": "IF(HASONEVALUE(FactOrderLine[currency]), SUM(FactOrderLine[refunded_sales_amount]))",
            "formatString": "#,##0.00",
            "description": "Gold refunded_sales_amount, by original order-date cohort. Blank across multiple currencies. Paid cancellations preserve capture and refund history.",
            "displayFolder": "Financial",
            "lineageTag": "20aba884-3dc2-553e-a107-efa40333bbc2"
          },
          {
            "name": "Refunded Tax",
            "expression": "IF(HASONEVALUE(FactOrderLine[currency]), SUM(FactOrderLine[refunded_tax_amount]))",
            "formatString": "#,##0.00",
            "description": "Gold refunded_tax_amount, by original order-date cohort. Blank across multiple currencies. Paid cancellations preserve capture and refund history.",
            "displayFolder": "Financial",
            "lineageTag": "6d641350-acde-58b9-96fc-196699fa312e"
          },
          {
            "name": "Refund Amount",
            "expression": "IF(HASONEVALUE(FactOrderLine[currency]), SUM(FactOrderLine[refund_amount]))",
            "formatString": "#,##0.00",
            "description": "Gold refund_amount, by original order-date cohort. Blank across multiple currencies. Paid cancellations preserve capture and refund history.",
            "displayFolder": "Financial",
            "lineageTag": "cc17e2d4-47d2-597d-b5db-8b1f6ac8f0d8"
          },
          {
            "name": "Net Sales",
            "expression": "IF(HASONEVALUE(FactOrderLine[currency]), SUM(FactOrderLine[net_sales_amount]))",
            "formatString": "#,##0.00",
            "description": "Gold net_sales_amount, by original order-date cohort. Blank across multiple currencies. Paid cancellations preserve capture and refund history.",
            "displayFolder": "Financial",
            "lineageTag": "4200a446-5101-5eb3-9de7-bfcd7b498600"
          },
          {
            "name": "Net Tax",
            "expression": "IF(HASONEVALUE(FactOrderLine[currency]), SUM(FactOrderLine[net_tax_amount]))",
            "formatString": "#,##0.00",
            "description": "Gold net_tax_amount, by original order-date cohort. Blank across multiple currencies. Paid cancellations preserve capture and refund history.",
            "displayFolder": "Financial",
            "lineageTag": "84ab5183-ff66-564c-a4d0-47d9684291d0"
          },
          {
            "name": "Net Cash",
            "expression": "IF(HASONEVALUE(FactOrderLine[currency]), SUM(FactOrderLine[net_cash_amount]))",
            "formatString": "#,##0.00",
            "description": "Gold net_cash_amount, by original order-date cohort. Blank across multiple currencies. Paid cancellations preserve capture and refund history.",
            "displayFolder": "Financial",
            "lineageTag": "559cc1a9-edc1-5175-b905-ee3132f8a1ee"
          },
          {
            "name": "Units Ordered",
            "expression": "SUM(FactOrderLine[units_ordered])",
            "formatString": "#,##0",
            "description": "Refunded quantities include paid cancellations before shipment.",
            "displayFolder": "Quantities",
            "lineageTag": "0d59e3fa-f239-5a2b-b21b-0ba271683fd0"
          },
          {
            "name": "Units Sold",
            "expression": "SUM(FactOrderLine[units_sold])",
            "formatString": "#,##0",
            "description": "Refunded quantities include paid cancellations before shipment.",
            "displayFolder": "Quantities",
            "lineageTag": "ec853510-2445-51b8-bcc0-69c58616dd94"
          },
          {
            "name": "Units Refunded",
            "expression": "SUM(FactOrderLine[units_returned])",
            "formatString": "#,##0",
            "description": "Refunded quantities include paid cancellations before shipment.",
            "displayFolder": "Quantities",
            "lineageTag": "11f8e516-67ad-5fba-b67f-043837677832"
          },
          {
            "name": "Net Units",
            "expression": "SUM(FactOrderLine[net_units])",
            "formatString": "#,##0",
            "description": "Refunded quantities include paid cancellations before shipment.",
            "displayFolder": "Quantities",
            "lineageTag": "a0bad0a9-3b4b-598e-a89c-8d36635c64ef"
          },
          {
            "name": "Order Count",
            "expression": "DISTINCTCOUNT(FactOrderLine[order_id])",
            "formatString": "#,##0",
            "description": "Distinct orders in the selected product/customer/date context.",
            "displayFolder": "Orders",
            "lineageTag": "934024ae-9a70-5642-ac9f-faa82c27c81a"
          },
          {
            "name": "Funded Orders",
            "expression": "CALCULATE([Order Count], FactOrderLine[is_funded] = 1)",
            "formatString": "#,##0",
            "description": "",
            "displayFolder": "Orders",
            "lineageTag": "3c4c8bf7-361f-5dd7-b50f-0b9ab072dbc2"
          },
          {
            "name": "Cancelled Orders",
            "expression": "CALCULATE([Order Count], FactOrderLine[status] = \"CANCELLED\")",
            "formatString": "#,##0",
            "description": "",
            "displayFolder": "Orders",
            "lineageTag": "d59fc4f8-2a76-5945-bcec-a58530bb2b00"
          },
          {
            "name": "Refunded Orders",
            "expression": "CALCULATE([Order Count], FactOrderLine[refund_amount] > 0)",
            "formatString": "#,##0",
            "description": "",
            "displayFolder": "Orders",
            "lineageTag": "3f353877-1acf-52a5-a249-c1f5373a9975"
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE([Sales Amount], [Funded Orders])",
            "formatString": "#,##0.00",
            "description": "Funded merchandise after discounts, before refunds, per funded order.",
            "displayFolder": "Financial",
            "lineageTag": "07d97a17-2618-58e3-aa81-ae37448e9440"
          },
          {
            "name": "Discount %",
            "expression": "DIVIDE([Discount Amount], [Gross Sales])",
            "formatString": "0.00%",
            "description": "Ratio of totals; both item and coupon discounts.",
            "displayFolder": "Financial",
            "lineageTag": "cd946983-d759-52b0-a7a1-054d975587de"
          },
          {
            "name": "Refund %",
            "expression": "DIVIDE([Refund Amount], [Captured Amount])",
            "formatString": "0.00%",
            "description": "Refunded cash divided by captured cash, both including tax.",
            "displayFolder": "Financial",
            "lineageTag": "13e26fe0-37f8-5a24-8f38-9f06cffc7928"
          },
          {
            "name": "Selected Currency",
            "expression": "SELECTEDVALUE(FactOrderLine[currency], \"Select one currency\")",
            "formatString": "",
            "description": "",
            "displayFolder": "Context",
            "lineageTag": "19060703-59db-5f1a-af65-4c4dc8c5c9aa"
          },
          {
            "name": "Refund Events",
            "expression": "COUNTROWS(FactRefund)",
            "formatString": "#,##0",
            "description": "Refund events in the order/date/customer context. Product filtering applies to line measures, not this event count.",
            "displayFolder": "Refund events",
            "lineageTag": "4a5df8e0-c14f-542f-90c6-25b076692fea"
          },
          {
            "name": "Event Refund Amount",
            "expression": "IF(HASONEVALUE(FactRefund[currency]), SUM(FactRefund[refund_amount]))",
            "formatString": "#,##0.00",
            "description": "Refund headers; use refund_day for refund-calendar analysis. Product filters do not filter refund headers.",
            "displayFolder": "Refund events",
            "lineageTag": "2f89dbfe-5f5b-5d12-80b5-263bf0576f96"
          }
        ]
      },
