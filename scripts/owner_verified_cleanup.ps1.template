# Owner-run only. Generated from pinned, fully read-back archive receipts.
param([switch]$VerifyOnly)
$ErrorActionPreference = 'Stop'
$planPath = '__PLAN_PATH__'
$planHash = '__PLAN_HASH__'
$helper = '__HELPER__'
if ((Get-FileHash -LiteralPath $planPath -Algorithm SHA256).Hash.ToLowerInvariant() -ne $planHash) { throw 'Cleanup plan changed' }
if ((Get-FileHash -LiteralPath $helper -Algorithm SHA256).Hash.ToLowerInvariant() -ne '__HELPER_HASH__') { throw 'Verification helper changed; regenerate script' }
$plan = Get-Content -LiteralPath $planPath -Raw | ConvertFrom-Json
$root = [IO.Path]::GetFullPath($plan.workspace).TrimEnd('\')
$prefix = $root + '\.local\'
$log = Join-Path $root '.local/cleanup-all-verified-removals.jsonl'
$env:PYTHONPATH = '__PYTHONPATH__'
$env:DIA_GATEWAY_POLICY = '__GATEWAY__'
# Each invocation gets its own bounded control journal, preserving all earlier checks.
$plan.control_receipts = Join-Path $root ('.local/cleanup-remote-' + [Guid]::NewGuid().ToString() + '.jsonl')
$invocationPlan = Join-Path $root ('.local/cleanup-plan-' + [Guid]::NewGuid().ToString() + '.json')
[IO.File]::WriteAllText($invocationPlan, ($plan | ConvertTo-Json -Depth 15), [Text.UTF8Encoding]::new($false))
$invocationHash = (Get-FileHash -LiteralPath $invocationPlan -Algorithm SHA256).Hash.ToLowerInvariant()
& '__PYTHON__' $helper --verify-plan $invocationPlan --plan-sha256 $invocationHash
if ($LASTEXITCODE -ne 0) { throw 'Remote archive verification failed; nothing deleted' }
if (-not ('DiaFileAllocation' -as [type])) { Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
public static class DiaFileAllocation {
 [DllImport("kernel32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
 public static extern uint GetCompressedFileSizeW(string path, out uint high);
}
'@
}
$before = [IO.DriveInfo]::new([IO.Path]::GetPathRoot($root)).AvailableFreeSpace
$removed = 0; $skipped = 0; $protected = 0; [long]$allocatedRemoved = 0; [long]$logicalRemoved = 0
foreach ($entry in $plan.files) {
    if ($entry.runtime_protected) { $protected++; continue }
    $full = [IO.Path]::GetFullPath($entry.path)
    if (-not $full.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase)) { throw 'Path left .local' }
    if (-not (Test-Path -LiteralPath $full)) { $skipped++; continue }
    $item = Get-Item -LiteralPath $full -Force
    if ($item.PSIsContainer) { throw 'Directories are forbidden' }
    $cursor = $item
    while ($null -ne $cursor) {
        if (($cursor.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw 'Reparse point refused' }
        if ($cursor.FullName.TrimEnd('\') -eq $root) { break }
        $cursor = if ($cursor -is [IO.DirectoryInfo]) { $cursor.Parent } else { $cursor.Directory }
    }
    if ($null -eq $cursor) { throw 'Workspace ancestor missing' }
    # Excluding FileShare.Write prevents content changes between hashing and deletion.
    $stream = [IO.File]::Open($full, [IO.FileMode]::Open, [IO.FileAccess]::Read, ([IO.FileShare]::Read -bor [IO.FileShare]::Delete))
    try {
        if ($stream.Length -ne $entry.bytes) { throw 'File length changed' }
        $sha = [Security.Cryptography.SHA256]::Create()
        try { $hash = ([BitConverter]::ToString($sha.ComputeHash($stream))).Replace('-', '').ToLowerInvariant() } finally { $sha.Dispose() }
        if ($hash -ne $entry.sha256) { throw 'File hash changed' }
        [uint32]$high = 0
        $low = [DiaFileAllocation]::GetCompressedFileSizeW($full, [ref]$high)
        if ($low -eq [uint32]::MaxValue -and [Runtime.InteropServices.Marshal]::GetLastWin32Error() -ne 0) { throw 'Allocation query failed' }
        [long]$allocation = ([long]$high * 4294967296) + $low
        if (-not $VerifyOnly) {
            @{phase='DELETE_INTENT';path=$full;sha256=$hash;allocated_bytes_before=$allocation;at=[DateTime]::UtcNow.ToString('o')} | ConvertTo-Json -Compress | Add-Content -LiteralPath $log
            Remove-Item -LiteralPath $full -Force -ErrorAction Stop
            $allocatedRemoved += $allocation; $logicalRemoved += $entry.bytes; $removed++
            @{phase='REMOVED';path=$full;sha256=$hash;logical_bytes=$entry.bytes;allocated_bytes_before=$allocation;removed_at=[DateTime]::UtcNow.ToString('o')} | ConvertTo-Json -Compress | Add-Content -LiteralPath $log
        }
    } finally { $stream.Dispose() }
}
$after = [IO.DriveInfo]::new([IO.Path]::GetPathRoot($root)).AvailableFreeSpace
Write-Output "Removed files: $removed; runtime-protected: $protected; already absent: $skipped; logical bytes: $logicalRemoved; summed allocation before removal: $allocatedRemoved; observed volume free-space increase: $($after-$before) bytes. Volume delta includes concurrent activity; shared hardlinks can reduce actual release. VerifyOnly: $VerifyOnly"
